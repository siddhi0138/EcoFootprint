node_modules/

# Build output - regenerated fresh by `npm run build` before every deploy, no need to track it
dist/

# Firebase CLI's local hosting-deploy cache (machine/session-specific, not project config)
.firebase/

# Frontend env
.env
.env.local
.env.*.local
!.env.example

# Backend env & secrets
backend/.env
backend/.env.*
!backend/.env.example
backend/secrets/

# Python
backend/venv/
backend/.venv/
backend/**/__pycache__/
*.pyc

# Generated vector store
backend/chroma_store/

# User-uploaded product images
backend/uploads/

# Firebase CLI debug logs
firebase-debug.log

# Backend runtime logs
backend/uvicorn.log
