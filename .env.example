# Firebase (client config — safe to expose publicly, protected by Firebase security rules,
# but kept out of source control for hygiene)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# OpenRouteService (genuine secret — see README note on rotating the old key)
VITE_OPEN_ROUTE_SERVICE_API_KEY=

# Backend API
VITE_API_BASE_URL=http://localhost:8000
