OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional - both LLM providers are tried in order (Gemini first) so one hitting its daily
# free-tier quota doesn't block AI features - see backend/services/llm.py
GEMINI_API_KEY=your-gemini-api-key-here
# Optional - general merchandise (electronics, clothing, home goods) search, since
# OpenFoodFacts only covers food/grocery. Free eBay Developer account, no approval wait
# (unlike Amazon PA API / Walmart's partner APIs): https://developer.ebay.com/
EBAY_CLIENT_ID=your-ebay-client-id-here
EBAY_CLIENT_SECRET=your-ebay-client-secret-here
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FRONTEND_ORIGIN=http://localhost:8080

# Email (order receipts, education certificates) - dual provider, tried in order so one
# outage doesn't block delivery. Neither uses a personal password:
#   Gmail: OAuth2 refresh token (run `python backend/scripts/get_gmail_refresh_token.py` once
#     after creating OAuth credentials in Google Cloud Console, gmail.send scope).
#   Resend: just an API key from resend.com, no OAuth flow needed.
# See services/gmail_service.py / services/email_service.py.
GMAIL_SENDER_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
